# コピーして .env.local を作り、自分の値を入れる（cp .env.example .env.local）。
# .env.local は git に入れない・チャットに貼らない。この .env.example には、名前と、値の入れ方だけを書く。

# --- Supabase（Project Settings → API / API Keys）---
# プロジェクトの URL。例：https://xxxxxxxx.supabase.co   （ブラウザに出る。入れてよい）
NEXT_PUBLIC_SUPABASE_URL=
# ブラウザ用の公開キー。anon（eyJ... で始まる）か、publishable（sb_publishable_... で始まる）のどちらか。
# 権限は RLS で守られているので、ブラウザに出てよい
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# サーバー専用の秘密のキー。service_role（eyJ...）か、secret（sb_secret_...）。RLS を通り抜けるので、
# ブラウザに出さない・NEXT_PUBLIC_ を付けない・コードに書かない。段階3以降（参加の処理、集計）で使う
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic（段階5で使う。今は空のままでよい）---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Unsplash（任意。場所の写真を自動で探すときだけ。無くても動く）---
UNSPLASH_ACCESS_KEY=

# --- 公開URL（段階7。ローカルでは http://localhost:3000）---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
